-- Drag detector
local UserInputService = game:GetService("UserInputService")

local frame = Holder
local isDragging = false
local dragStartPos = Vector2.new()
local frameStartPos = UDim2.new()

-- Fires when the player clicks or taps on the frame
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true

		-- Record the initial cursor position and frame position
		dragStartPos = UserInputService:GetMouseLocation()
		frameStartPos = frame.Position

		-- Prevent other UI elements from capturing input while dragging
		local connection
		connection = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				isDragging = false
				connection:Disconnect()
			end
		end)
	end
end)
-- Listens globally for screen cursor movements while dragging is active
UserInputService.InputChanged:Connect(function(input)
	if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local currentMousePos = UserInputService:GetMouseLocation()

		-- Calculate how far the cursor has moved from the drag origin
		local delta = currentMousePos - dragStartPos

		-- Update the frame's position by adding the pixel offset
		frame.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
	end
end)

