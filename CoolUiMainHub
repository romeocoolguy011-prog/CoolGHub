-- Function to create and attach the health UI and body highlight to a character
local function createHealthUI(character)
	if not espActive then return end
	if character == localPlayer.Character then return end

	-- Look for the Humanoid and Head parts safely
	local humanoid = character:WaitForChild("Humanoid", 10)
	local head = character:WaitForChild("Head", 10)
	if not humanoid or not head then return end

	-- Avoid stacking duplicates if already highlighted
	if head:FindFirstChild("ESP_HealthUI") or character:FindFirstChild("ESP_Highlight") then return end

	-- 1. Create the Full-Body Wallhack Silhouette (Highlight)
	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_Highlight"
	highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Red fill
	highlight.FillTransparency = 0.5 -- See-through body fill
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- White outline
	highlight.OutlineTransparency = 0
	highlight.Adornee = character
	highlight.Parent = character
	table.insert(activeESPObjects, highlight)

	-- 2. Create the BillboardGui (The container that floats over the character)
	local billboardGui = Instance.new("BillboardGui")
	billboardGui.Name = "ESP_HealthUI"
	billboardGui.Size = UDim2.new(0, 100, 0, 15) -- Size of the health bar
	billboardGui.StudsOffset = Vector3.new(0, 2.5, 0) -- Position it above their head
	billboardGui.AlwaysOnTop = true -- THIS MAKES IT SHOW THROUGH WALLS
	billboardGui.ResetOnSpawn = false

	-- 3. Create the Background Frame (The empty/red bar slot)
	local backgroundFrame = Instance.new("Frame")
	backgroundFrame.Name = "Background"
	backgroundFrame.Size = UDim2.new(1, 0, 1, 0)
	backgroundFrame.BackgroundColor3 = Color3.fromRGB(150, 0, 0) -- Dark Red
	backgroundFrame.BorderSizePixel = 1
	backgroundFrame.Parent = billboardGui

	-- 4. Create the Fill Frame (The green bar that shrinks/grows)
	local fillFrame = Instance.new("Frame")
	fillFrame.Name = "Fill"
	fillFrame.Size = UDim2.new(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 0, 1, 0)
	fillFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Bright Green
	fillFrame.BorderSizePixel = 0
	fillFrame.Parent = backgroundFrame

	-- 5. Create a Text Label to show raw numbers (e.g., "100/100")
	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "HealthText"
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth)
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 10
	textLabel.Font = Enum.Font.SourceSansBold
	textLabel.Parent = backgroundFrame

	-- Function to dynamically update the health bar size and text
	local function updateHealth()
		local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		fillFrame.Size = UDim2.new(healthRatio, 0, 1, 0)
		textLabel.Text = math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth)
	end

	-- Listen for health changes
	local healthConnection = humanoid:GetPropertyChangedSignal("Health"):Connect(updateHealth)
	local maxHealthConnection = humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateHealth)

	-- Clean up events, tracking UI, and highlight silhouettes if the player dies
	humanoid.Died:Connect(function()
		healthConnection:Disconnect()
		maxHealthConnection:Disconnect()
		billboardGui:Destroy()
		highlight:Destroy()
	end)

	-- Parent the UI to the enemy's head
	billboardGui.Adornee = head
	billboardGui.Parent = head
	table.insert(activeESPObjects, billboardGui)
end

-- Central Execution Wrapper to turn state ON or OFF cleanly
local function toggleESP(forcedState, buttonInstance)
	if forcedState ~= nil then
		espActive = forcedState
	else
		espActive = not espActive
	end

	-- Update Hub Menu Visual Aesthetics if a button was parsed through
	if buttonInstance then
		buttonInstance.Text = espActive and "ESP: ACTIVE" or "ESP (L)"
		buttonInstance.BackgroundColor3 = espActive and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(115, 0, 255)
	end

	if not espActive then
		-- Turn Off: Purge existing UI overlay and structural outline highlights
		for _, instance in ipairs(activeESPObjects) do
			if instance and instance.Parent then
				instance:Destroy()
			end
		end
		activeESPObjects = {}
	else
		-- Turn On: Instantiate elements for everyone currently loaded in
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= localPlayer and player.Character then
				task.spawn(createHealthUI, player.Character)
			end
		end
	end
end

-- Monitor players entering the match or respawning
local function onPlayerAdded(player)
	if player == localPlayer then return end

	player.CharacterAdded:Connect(function(character)
		if espActive then
			createHealthUI(character)
		end
	end)

	if player.Character and espActive then
		createHealthUI(player.Character)
	end
end

-- Bind internal global player listing listeners
for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)

-- KEYBOARD HOTKEY LISTENER [L]
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end -- Skip if typing in chat
	if input.KeyCode == TOGGLE_KEY then
		-- Update state (Will update menu buttons if they share the tag name)
		local hubButton = localPlayer.PlayerGui:FindFirstChild("ESP (L)", true)
		toggleESP(nil, hubButton)
	end
end)

