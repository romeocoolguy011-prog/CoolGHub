-- CONFIGURATION
local FOV_RADIUS = 150 -- The radius of your aimbot zone in pixels
local TOGGLE_KEY = Enum.UserInputType.MouseButton3-- Middle-click to toggle ON/OFF
local SMOOTHNESS = 0.25 -- Lower = smoother/slower tracking (0.01 to 1)

-- Shared Variables (Scope-lifted out of the button constructor)
local aimbotEnabled = false
local fovCircle = nil
local uiStroke = nil

-- Toggle logic: Swaps between true and false on every press
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- Ignore inputs typed into chat or menus
	if gameProcessed then return end

	if input.UserInputType == TOGGLE_KEY or input.KeyCode == TOGGLE_KEY then
		aimbotEnabled = not aimbotEnabled -- This flips true to false, or false to true

		-- Visual cue: Turn the circle Green when ON, and Red when OFF (only if UI has been spawned)
		if uiStroke then
			if aimbotEnabled then
				uiStroke.Color = Color3.fromRGB(0, 255, 0) -- Green = Active
			else
				uiStroke.Color = Color3.fromRGB(255, 0, 0) -- Red = Disabled
			end
		end
	end
end)

-- Find the closest valid character inside the FOV circle
local function getClosestPlayerInFOV()
	local closestPlayer = nil
	local shortestDistance = math.huge
	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local char = player.Character
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local head = char:FindFirstChild("Head")

			-- Ensure the player is alive and has a Head
			if humanoid and humanoid.Health > 0 and head then
				-- Convert the character's head position to 2D screen coordinates
				local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)

				if onScreen then
					local playerCoord = Vector2.new(screenPos.X, screenPos.Y)
					local distanceFromCenter = (playerCoord - screenCenter).Magnitude

					-- Check if they are inside our target crosshair zone
					if distanceFromCenter <= FOV_RADIUS then
						-- Calculate their actual 3D distance to see who is closest to you
						local characterDistance = (head.Position - camera.CFrame.Position).Magnitude

						if characterDistance < shortestDistance then
							shortestDistance = characterDistance
							closestPlayer = head
						end
					end
				end
			end
		end
	end

	return closestPlayer
end

-- Run every frame right before rendering to adjust camera angles via artificial mouse delta
RunService.RenderStepped:Connect(function()
	if aimbotEnabled then
		local targetHead = getClosestPlayerInFOV()

		if targetHead then
			-- 1. Convert target position to screen pixel coordinates
			local screenPos, onScreen = camera:WorldToViewportPoint(targetHead.Position)

			if onScreen then
				local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

				-- 2. Find the pixel offset from your crosshair to the target head
				local offset = Vector2.new(screenPos.X - screenCenter.X, screenPos.Y - screenCenter.Y)

				-- 3. Factor in the player's in-game camera sensitivity setting so tracking speeds remain consistent
				local sensitivity = UserGameSettings.MouseSensitivity
				local moveX = (offset.X / sensitivity) * SMOOTHNESS
				local moveY = (offset.Y / sensitivity) * SMOOTHNESS

				-- 4. Inject artificial input movement directly into the engine handler
				pcall(function()
					UserInputService.MouseDeltaSensitivity = sensitivity * 10
					debug.setconstant(2, 1, moveX) 
				end)

				-- Fallback camera rotation construction logic if environment permissions restrict debugging hooks
				local lookAtCFrame = CFrame.lookAt(camera.CFrame.Position, targetHead.Position)
				camera.CFrame = camera.CFrame:Lerp(lookAtCFrame, SMOOTHNESS)
			end
		end
	end
end)

