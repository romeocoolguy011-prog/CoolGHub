-- Main button creation
local function CreateNewButton(Config : {}, Callback)
	local Button = Instance.new("TextButton", Config.Parent)
	Button.Size = Config.Size
	Button.Position = Config.Position
	Button.BackgroundColor3 = Config.Color
	Button.Text = Config.Text
	Button.TextColor3 = Config.TextColor
	Button.Font = Enum.Font.SourceSansBold
	Button.TextScaled = true
	Button.TextStrokeTransparency = 0
	Button.BorderSizePixel = 0

	task.spawn(function()
		Connections[Button] = Button.MouseButton1Click:Connect(function()
			Callback(Button)
		end)
	end)
	
	return Button
end

local function CreateTextBox(Config : {}, Callback)
	local Button = Instance.new("TextBox", Config.Parent)
	Button.Size = Config.Size
	Button.Position = Config.Position
	Button.BackgroundColor3 = Config.Color
	Button.Text = Config.Text or ""
	Button.TextColor3 = Config.TextColor
	Button.Font = Enum.Font.SourceSansBold
	Button.TextScaled = true
	Button.TextStrokeTransparency = 0
	Button.BorderSizePixel = 0
	Button.PlaceholderText = Config.PlaceText
	
	task.spawn(function()
		Connections[Button] =  Button.FocusLost:Connect(function(enterPressed, _inp)
			if enterPressed then
				Callback(Button.Text, Button)
			else
				Button.Text = ""
			end
		end)
	end)

	return Button
end

